# Abhängigkeiten (per npm install neu erzeugbar, nicht versionieren)
node_modules/

# Build-Ausgaben (per npm run build / npm run dist neu erzeugbar)
frontend/dist/
desktop/dist/
# Manuell exportierter/kopierter Installer-Build (enthält u. a. die über
# 100MB große win-unpacked/AzubiPrep.exe – GitHub verweigert Pushes mit
# Dateien über diesem Limit, siehe auch desktop/dist/ oben)
/Installer/

# Playwright-Testausgaben (OPS-010, Stufe 4 – per "npm test" neu erzeugbar)
e2e/playwright-report/
e2e/test-results/

# Logs
*.log
npm-debug.log*

# Editor-/OS-Dateien
.DS_Store
Thumbs.db
.vscode/
.idea/

# Umgebungsvariablen (Secrets nicht versionieren)
.env
.env.local
