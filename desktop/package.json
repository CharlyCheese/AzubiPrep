{
  "name": "azubiprep-desktop",
  "private": true,
  "version": "0.1.1",
  "author": "Sven Weyers",
  "description": "AzubiPrep als installierbare Windows-Desktop-App (Electron-Hülle um das bestehende React-Frontend + Node/Express-Backend).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/build-desktop.cjs",
    "test:desktop": "node --test test/desktop-package.test.cjs",
    "dist:web": "node scripts/build-web.cjs",
    "test:web": "node --test test/web-runtime.test.cjs"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "de.sven-weyers.azubiprep",
    "productName": "AzubiPrep",
    "directories": {
      "output": "../Installer"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["src/**/*", "node_modules/**/*", "package.json", "!**/.env*", "!**/*.log", "!**/.cache/**/*"]
      },
      { "from": "../content", "to": "content", "filter": ["**/*", "!**/.env*"] },
      { "from": "../frontend/dist", "to": "frontend/dist", "filter": ["**/*", "!**/.env*"] }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
