{
  "name": "azubiprep-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "AzubiPrep als installierbare Windows-Desktop-App (Electron-Hülle um das bestehende React-Frontend + Node/Express-Backend).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "de.sven-weyers.azubiprep",
    "productName": "AzubiPrep",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "../backend", "to": "backend", "filter": ["**/*", "!**/*.log"] },
      { "from": "../content", "to": "content" },
      { "from": "../frontend/dist", "to": "frontend/dist" }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
