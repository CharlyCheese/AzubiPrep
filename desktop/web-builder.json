{
  "extends": null,
  "appId": "de.azubiprep.web",
  "productName": "AzubiPrep Web",
  "directories": { "output": "../Installer-Web" },
  "extraMetadata": { "main": "web-main.cjs" },
  "files": ["web-main.cjs", "web-runtime.cjs", "package.json"],
  "extraResources": [
    {
      "from": "../backend",
      "to": "backend",
      "filter": ["src/**/*", "node_modules/**/*", "package.json", "!**/.env*", "!**/local-ai/**", "!**/local-rag/**", "!**/accounts.json", "!**/chatgpt-auth.json", "!**/chatgpt-host.json", "!**/*.log", "!**/.cache/**/*"]
    },
    { "from": "../content", "to": "content", "filter": ["**/*", "!**/.env*", "!**/local-ai/**", "!**/local-rag/**", "!**/accounts.json", "!**/chatgpt-auth.json", "!**/chatgpt-host.json"] },
    { "from": "../frontend/dist", "to": "frontend/dist", "filter": ["**/*", "!**/.env*", "!**/local-ai/**", "!**/local-rag/**", "!**/accounts.json", "!**/chatgpt-auth.json", "!**/chatgpt-host.json"] }
  ],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "../frontend/public/icon-512.png"
  },
  "nsis": {
    "artifactName": "AzubiPrep-Web-Setup-${version}.${ext}",
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": true,
    "installerLanguages": ["de_DE"]
  },
  "portable": { "artifactName": "AzubiPrep-Web-${version}-portabel.${ext}" }
}
