# Optionale KI-Anbindung. Ohne Auswahl in der App bleibt KI aus.
AI_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
AI_TIMEOUT_MS=90000
AI_STATUS_TIMEOUT_MS=3000
# Entwicklungsstart: Projekt/local-ai; installierte Pakete: eigenes App-Profil.
# AZUBIPREP_AI_DIR=
# Private PDFs und Ableitungen: Projekt/local-rag; nie im öffentlichen Inhalt.
# AZUBIPREP_RAG_DIR=
# Für ChatGPT-Abo-Anmeldung wird kein API-Schlüssel benötigt.
# Datenbank/Login bleiben optional; siehe docs/19-Datenbank-Login.md.
