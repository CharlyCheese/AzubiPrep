    "jsonwebtoken": "^9.0.2",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.13.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "supertest": "^7.0.0",
    "vitest": "^5.0.0"
  }
