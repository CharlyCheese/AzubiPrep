  "version": "0.1.0",
  "author": "Sven Weyers",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "validate": "node scripts/validate-content.mjs",
    "repair-ft": "node scripts/repair-ft-rows.mjs",
    "statistik": "node scripts/content-statistik.mjs",
